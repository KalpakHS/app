{
  "expo": {
    "name": "SmartNeb",
    "slug": "smartneb-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.smartneb.app"
    },
    "android": {
      "package": "io.smartneb.app"
    },
    "extra": {
      "defaultHost": "172.16.14.143",
      "defaultPort": "3000"
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
